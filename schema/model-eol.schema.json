{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://thossullivan.github.io/model-eol/schema/0.1/model-eol.schema.json",
  "title": "model-eol feed",
  "description": "A machine-readable deprecation feed for AI models, version model-eol/0.1.",
  "type": "object",
  "required": ["spec", "publisher", "generated", "models"],
  "properties": {
    "spec": { "const": "model-eol/0.1" },
    "publisher": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$" },
    "generated": { "type": "string", "maxLength": 64, "format": "date-time", "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$" },
    "source": { "$ref": "#/definitions/url" },
    "note": { "$ref": "#/definitions/text" },
    "policy": {
      "type": "object",
      "required": ["min_notice_days", "source"],
      "properties": {
        "min_notice_days": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "source": { "$ref": "#/definitions/url" }
      },
      "additionalProperties": false
    },
    "models": {
      "type": "array",
      "items": { "$ref": "#/definitions/model" }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "isoDate": { "type": "string", "format": "date", "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])$" },
    "text": { "type": "string", "maxLength": 4096, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$" },
    "url": { "type": "string", "maxLength": 4096, "format": "uri", "pattern": "^[Hh][Tt][Tt][Pp][Ss]?:[^\\u0000-\\u001f\\u007f-\\u009f]*$" },
    "model": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "aliases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }
        },
        "announced": { "$ref": "#/definitions/isoDate" },
        "shutdown": { "$ref": "#/definitions/isoDate" },
        "date_precision": { "enum": ["exact", "earliest", "tentative"] },
        "replacement": { "type": "string", "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "replacement_options": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }
        },
        "replacement_note": { "$ref": "#/definitions/text" },
        "notes": { "$ref": "#/definitions/text" },
        "source": { "$ref": "#/definitions/url" },
        "distributions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["via"],
            "properties": {
              "via": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(?![Pp][Uu][Bb][Ll][Ii][Ss][Hh][Ee][Rr](?:-[Ff][Aa][Ll][Ll][Bb][Aa][Cc][Kk\\u212a])?$)[^\\u0000-\\u001f\\u007f-\\u009f]*$" },
              "announced": { "$ref": "#/definitions/isoDate" },
              "shutdown": { "$ref": "#/definitions/isoDate" },
              "date_precision": { "enum": ["exact", "earliest", "tentative"] },
              "status": { "enum": ["active", "legacy", "extended-access", "retired"] },
              "source": { "$ref": "#/definitions/url" }
            },
            "oneOf": [
              { "properties": { "date_precision": { "enum": ["exact", "earliest"] } } },
              {
                "required": ["date_precision", "shutdown"],
                "properties": {
                  "date_precision": { "const": "tentative" },
                  "announced": false,
                  "status": { "enum": ["active", "legacy", "extended-access"] }
                }
              }
            ],
            "additionalProperties": false
          }
        }
      },
      "dependencies": {
        "replacement": {
          "properties": {
            "replacement_options": false
          }
        },
        "replacement_options": {
          "properties": {
            "replacement": false
          }
        }
      },
      "oneOf": [
        { "properties": { "date_precision": { "enum": ["exact", "earliest"] } } },
        {
          "required": ["date_precision", "shutdown"],
          "properties": {
            "date_precision": { "const": "tentative" },
            "announced": false
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
