name: Refresh model feeds

on:
  schedule:
    - cron: '17 5 * * 1'
  workflow_dispatch:

permissions:
  contents: write
  pull-requests: write

jobs:
  refresh:
    runs-on: ubuntu-latest
    env:
      # Keep provider credentials scoped to this workflow job.
      OPENAI_API_KEY: ${{ secrets.OPENAI_API_KEY }}
      ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
      GH_TOKEN: ${{ github.token }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
      - id: diff
        name: Check for feed changes
        shell: bash
        run: |
          set +e
          node refresh/refresh.mjs --check > refresh-diff.md
          refresh_code=$?
          if [ "$refresh_code" -ne 0 ] && [ "$refresh_code" -ne 3 ]; then
            exit "$refresh_code"
          fi
          if [ "$refresh_code" -eq 3 ]; then
            echo 'changed=true' >> "$GITHUB_OUTPUT"
          else
            echo 'changed=false' >> "$GITHUB_OUTPUT"
          fi
      - name: Regenerate feeds and open PR
        if: steps.diff.outputs.changed == 'true'
        shell: bash
        run: |
          git switch --create model-eol/feed-refresh
          node refresh/refresh.mjs --out feeds
          git add feeds/openai.json feeds/anthropic.json
          git commit -m 'chore: refresh model feeds'
          git push --set-upstream origin model-eol/feed-refresh
          gh pr create --title 'chore: refresh model feeds' --body-file refresh-diff.md
